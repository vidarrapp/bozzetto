# Local-dev template for Cloudflare Pages Functions bindings.
#
#   cp wrangler.toml.example wrangler.toml
#
# Then run `npm run db:migrate:local` and `npm run cf:dev` for a full-stack
# local server (D1 + R2 are emulated locally).
#
# PRODUCTION bindings are configured in the Cloudflare Pages dashboard
# (Settings -> Functions -> D1 database bindings / R2 bucket bindings), so the
# real wrangler.toml is gitignored and never affects the git-integration deploy.

name = "bozzetto"
compatibility_date = "2024-11-01"
pages_build_output_dir = "dist"

[[d1_databases]]
binding = "DB"
database_name = "bozzetto"
# For local dev any placeholder works; for a real remote db use the id from
# `wrangler d1 create bozzetto`.
database_id = "00000000-0000-0000-0000-000000000000"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "bozzetto-assets"

# Optional vars.
# [vars]
# ADMIN_EMAILS = "you@example.com"   # restrict admin writes to these identities
# DEV_ADMIN = "true"                 # LOCAL ONLY: bypass Access so the /admin
#                                    # editor works in `npm run cf:dev`. Honoured
#                                    # on localhost / 127.0.0.1 / [::1] only, and
#                                    # ignored on any other host.
#
# Required in the Pages dashboard (Production and Preview), not here: on any
# host but a loopback one the admin routes verify the Access JWT against these
# and answer 503 without them. Locally the email header is trusted as it comes.
# ACCESS_TEAM_DOMAIN = "yourteam.cloudflareaccess.com"
# ACCESS_AUD = "<application audience tag>"

# --- Accounts (docs/accounts.md §11) -----------------------------------------
# Variables: set in the dashboard (Settings -> Variables and Secrets) for
# Production, and in the staging project for staging; locally, under [vars]
# above. All are optional; what each one's absence means is beside it in
# functions/_shared/env.ts.
#
# ACCOUNTS_ENABLED = "true"   # accounts on. Unset (or anything else) the site is
#                             # 0.5.5 with templates whatever else is set, so the
#                             # rest can be set ahead of the switch.
# APP_ORIGIN = "https://bozzetto.vidarrapp.se"
#                             # the app's origin: what WebAuthn and Turnstile check,
#                             # and the one origin whose pages may read the files
#                             # host by script (CORS).
# RP_ID = "bozzetto.vidarrapp.se"
#                             # the passkey relying party: the app's host name.
# MEDIA_ORIGIN = "https://files.vidarrapp.se"
#                             # the files host, a second custom domain on this
#                             # project: it answers GET /m/* and nothing else, and
#                             # manifests name template files there - once
#                             # APP_ORIGIN is set too, so the app may read them.
#                             # Unset, they are on this origin's /media/. The build
#                             # variable VITE_MEDIA_ORIGIN takes the same value.
# TURNSTILE_SITE_KEY = "0x4AAAA..."
#                             # the widget's key, sent to the client only while
#                             # TURNSTILE_SECRET is set as well. Staging may use
#                             # Cloudflare's test pair, 1x00000000000000000000AA
#                             # with the secret 1x0000000000000000000000000000000AA.
# MAIL_FROM = "Bozzetto <login@vidarrapp.se>"
#                             # the sender of sign-in codes and notices; with
#                             # RESEND_API_KEY set and this not, mail is refused.
# DEV_TEST_HOOKS = "true"     # LOCAL ONLY: the X-Test-Now clock and /api/dev/*.
#                             # Honoured on a loopback host and nowhere else.
# TURNSTILE_VERIFY_URL = "http://127.0.0.1:8789/verify"
#                             # LOCAL ONLY: a stand-in for Turnstile's siteverify,
#                             # for the tests. Ignored off loopback.
#
# Secrets: encrypted in the dashboard, or `npx wrangler pages secret put NAME`,
# and locally in .dev.vars (gitignored) - never in this file:
#   AUTH_SECRET       keys every HMAC: email codes, rate-limit buckets.
#                     `openssl rand -base64 32`, one per project.
#   TURNSTILE_SECRET  Turnstile's secret key. Unset, Turnstile passes on a
#                     loopback host and is refused (503) anywhere else.
#   RESEND_API_KEY    Resend's API key. Unset, mail goes to dev_outbox on a
#                     loopback host (read it back with GET /api/dev/outbox?to=
#                     under DEV_TEST_HOOKS) and is refused anywhere else.
#                     At most 90 mails go out per UTC day.
#
# Build variables: set in the dashboard (Settings -> Variables and Secrets,
# which a build reads as well), never here - they shape what `npm run build`
# writes, not what the Functions read:
#   VITE_MEDIA_ORIGIN "https://files.vidarrapp.se": MEDIA_ORIGIN's value, read
#                     at build time, so the installed app keeps the files
#                     host's thumbnails. Anything but an origin fails the build.
#   NODE_VERSION      "22": the passkey library and its certificate parser
#                     need Node 20 or later.
#
# TERMS_VERSION is not a variable but a constant, in
# functions/_shared/config.ts: it changes in the commit that changes
# public/legal/terms.html, so the version an account accepts is always the
# text that shipped with it.
#
# public/_routes.json keeps Functions to /api/*, /admin/api/*, /admin/login,
# /media/* and /m/*. A Function anywhere else never runs, and a static file
# never meets functions/_middleware.ts, nor is billed as a Functions request.
