{
  "name": "bozzetto",
  "version": "0.6.3",
  "description": "Sculpt, paint and timelapses.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen:sample": "node scripts/generate-sample.mjs",
    "predev": "node scripts/generate-sample.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "check:functions": "node tests/functions/check.mjs",
    "prebuild": "node scripts/generate-sample.mjs",
    "build": "tsc --noEmit && vite build",
    "build:test": "tsc --noEmit && vite build --mode test",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply bozzetto --local",
    "db:migrate": "wrangler d1 migrations apply bozzetto --remote",
    "rig:json": "node tools/dump-rig.mjs",
    "rig:fixture": "node tools/make-test-glb.mjs && node tools/make-test-glb.mjs --bare",
    "rig:check": "node tools/inspect-glb.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:build": "npm run build:test && node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "client-zip": "2.5.1",
    "gifenc": "^1.0.3",
    "gl-matrix": "^3.4.4",
    "mediabunny": "^1.61.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.149.0"
  }
}
